{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "uipath-autofix",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "vars": {
    // Release.ProcessKey (the package / process name in Orchestrator) → GitHub repo.
    "PROCESS_REPO_MAP": { "AutofixDemo": "marcelocruzrpa/autofix-demo" },
    // Suppress identical faults (same process + normalized error) for this long.
    "DEDUPE_TTL_SECONDS": "3600",
    "EVENT_TYPE": "uipath-job-faulted",
    // For deep links in PRs/issues, e.g. https://cloud.uipath.com/<org>/<tenant>/orchestrator_
    "ORCHESTRATOR_BASE_URL": "https://staging.uipath.com/marcelocruz/DefaultTenant/orchestrator_",
    // Set "true" during setup to log the shape of deliveries: the payload's keys with value
    // types, and how the signature is encoded. No values are logged. Turn off afterwards.
    "LOG_PAYLOAD_SHAPE": "true"
  },
  "kv_namespaces": [
    // Create with: npx wrangler kv namespace create DEDUPE  → paste the id here.
    { "binding": "DEDUPE", "id": "f25cdca45f644bebb74899b0b5ce4a53" }
  ]
  // Secrets (never in this file):
  //   npx wrangler secret put UIPATH_WEBHOOK_SECRET
  //   npx wrangler secret put GITHUB_DISPATCH_TOKEN
}
